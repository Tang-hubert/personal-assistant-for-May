# Copy to .env and fill in. Save as UTF-8 WITHOUT BOM (a BOM breaks the first key).
# Never commit .env.

APP_ENV=dev

# Use a DIFFERENT bot for dev and prod. Two long-polling processes on one token
# cause 409 Conflict and dropped messages. Create a second bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to talk to the bot.
TELEGRAM_ALLOWED_USER_IDS=

GEMINI_API_KEY=
# Must have an entry in MODEL_PRICES (src/config.py), or startup fails.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional spare model, tried once when GEMINI_MODEL answers 429/503/504 (images and audio too).
# Must also be in MODEL_PRICES; ignored when it equals GEMINI_MODEL. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

DISCORD_OPS_WEBHOOK_URL=

DEFAULT_DAILY_BUDGET_USD=0.20
# SQLite DB and media originals live here. In Docker this is /app/data.
DATA_DIR=data

# Photo gate: a Laplacian variance below this counts as blurry.
BLUR_THRESHOLD=100.0
# Seconds of quiet before a photo burst is closed into one batch.
BATCH_DEBOUNCE_SECONDS=5.0
